PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=medicine_recommender
DB_HOST=localhost
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Without these, emails are only logged to the console (dev mode).
#
# OPTION 1 — Gmail (free, recommended for development)
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Search "App passwords" → create one for "Mail"
#   4. Use the 16-character app password below (NOT your Gmail login password)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FROM_NAME=HealthConnect
FROM_EMAIL=your_gmail@gmail.com
#
# OPTION 2 — Outlook / Hotmail
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_EMAIL=your_email@outlook.com
# SMTP_PASSWORD=your_password
#
# OPTION 3 — Mailtrap (catch-all inbox for testing, emails never reach real users)
# Sign up free at https://mailtrap.io → Inboxes → SMTP Settings
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_EMAIL=your_mailtrap_user
# SMTP_PASSWORD=your_mailtrap_password

# ── Twilio SMS (optional) ─────────────────────────────────────────────────────
# Without these, SMS is only logged to the console (dev mode).
# Sign up at https://www.twilio.com — free trial gives ~$15 credit
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Web Push VAPID ────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@healthconnect.com

# ── Chapa Payment ─────────────────────────────────────────────────────────────
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxx
CHAPA_ENCRYPTION_KEY=your_encryption_key
